{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "1104px",
			"wideSize": "1200px"
		},
		"color": {
			"palette": [
				{
					"slug": "cave-charcoal",
					"name": "Cave Charcoal",
					"color": "#19252C"
				},
				{
					"slug": "charcoal-deep",
					"name": "Charcoal Deep",
					"color": "#141F25"
				},
				{
					"slug": "charcoal-surface",
					"name": "Charcoal Surface",
					"color": "#213039"
				},
				{
					"slug": "charcoal-raised",
					"name": "Charcoal Raised",
					"color": "#283A44"
				},
				{
					"slug": "olive-dark",
					"name": "Olive Dark",
					"color": "#2A3A23"
				},
				{
					"slug": "utility-olive",
					"name": "Utility Olive",
					"color": "#566634"
				},
				{
					"slug": "lime",
					"name": "Lime",
					"color": "#D6F25B"
				},
				{
					"slug": "light-concrete",
					"name": "Light Concrete",
					"color": "#E2E5E1"
				},
				{
					"slug": "concrete-grey",
					"name": "Concrete Grey",
					"color": "#767F70"
				},
				{
					"slug": "muted",
					"name": "Muted Text",
					"color": "#C3CBBF"
				},
				{
					"slug": "white",
					"name": "White",
					"color": "#FFFFFF"
				},
				{
					"slug": "base",
					"name": "Base",
					"color": "#19252C"
				},
				{
					"slug": "primary",
					"name": "Primary",
					"color": "#D6F25B"
				},
				{
					"slug": "primary-light",
					"name": "Primary Light",
					"color": "#E4F88A"
				},
				{
					"slug": "body-text",
					"name": "Body Text",
					"color": "#F2F4F0"
				},
				{
					"slug": "heading",
					"name": "Headings",
					"color": "#FFFFFF"
				},
				{
					"slug": "section-bg",
					"name": "Section Background",
					"color": "#141F25"
				},
				{
					"slug": "top-bar",
					"name": "Top Bar",
					"color": "#111A1F"
				},
				{
					"slug": "background",
					"name": "Background",
					"color": "#19252C"
				},
				{
					"slug": "foreground",
					"name": "Foreground",
					"color": "#F2F4F0"
				},
				{
					"slug": "border-color",
					"name": "Border Color",
					"color": "#2E404A"
				}
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"slug": "inter",
					"name": "Inter",
					"fontFamily": "\"Inter\", system-ui, -apple-system, \"Segoe UI\", sans-serif"
				},
				{
					"slug": "instrument-serif",
					"name": "Instrument Serif",
					"fontFamily": "\"Instrument Serif\", Georgia, serif"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--cave-charcoal)",
			"text": "var(--wp--preset--color--body-text)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--inter)",
			"fontSize": "17px",
			"lineHeight": "1.6"
		},
		"spacing": {
			"blockGap": "0px",
			"padding": {
				"top": "0px",
				"right": "0px",
				"bottom": "0px",
				"left": "0px"
			}
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--inter)",
					"fontWeight": "800",
					"lineHeight": "1.1"
				},
				"color": {
					"text": "var(--wp--preset--color--heading)"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--lime)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--primary-light)"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--lime)",
					"text": "var(--wp--preset--color--cave-charcoal)"
				},
				"border": {
					"radius": "8px"
				},
				"typography": {
					"fontWeight": "700"
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"area": "header",
			"title": "Header"
		},
		{
			"name": "footer",
			"area": "footer",
			"title": "Footer"
		}
	]
}
